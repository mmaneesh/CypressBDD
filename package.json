{
  "name": "cypress-bdd-saucedemo",
  "version": "1.0.0",
  "description": "A Cypress BDD end-to-end test suite for SauceDemo",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "reports:clean": "rimraf cypress/reports cypress/screenshots cypress/videos",
    "pretest": "npm run reports:clean",
    "test": "npm run cy:run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "validate": "npm run lint && npm run format:check && npm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,json,md,yml,yaml,feature}": "prettier --check",
    "*.js": "eslint"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "26.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "2.2.8",
    "@eslint/js": "10.0.1",
    "cypress": "15.21.0",
    "cypress-mochawesome-reporter": "5.0.0",
    "cypress-on-fix": "1.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3"
  },
  "author": "Maneesh",
  "license": "ISC",
  "engines": {
    "node": ">=24.18.0 <25"
  }
}
