{
  "name": "amazonautomation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "reports:clean": "rimraf cypress/reports",
    "report:merge": "mochawesome-merge \"cypress/reports/mocha/*.json\" > cypress/reports/mochawesome.json",
    "report:generate": "marge cypress/reports/mochawesome.json -f report -o cypress/reports",
    "report": "npm run report:merge && npm run report:generate",
    "pretest": "npm run reports:clean",
    "test": "npm run cy:run"
  },
  "dependencies": {},
  "devDependencies": {
    "cypress": "^4.6.0",
    "cypress-cucumber-preprocessor": "^2.3.1",
    "cypress-multi-reporters": "^1.4.0",
    "cypress-wait-until": "^1.7.1",
    "cypress-xpath": "^1.4.0",
    "mocha": "^7.2.0",
    "mochawesome": "^6.1.1",
    "mochawesome-merge": "^4.0.3",
    "mochawesome-report-generator": "^5.1.0",
    "rimraf": "^2.7.1"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": true
  },
  "author": "Maneesh",
  "license": "ISC"
}
