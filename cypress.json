{
    "ignoreTestFiles": "*.js",
    "reporter": "mochawesome",
    "reporterOptions": {
          "reportDir": "cypress/reports/mocha",
          "quiet": true,
          "overwrite": false,
          "html": false,
          "json": true,
          "timestamp" : "mmddyyyy_HHMMss"
    },
    "screenshotOnRunFailure":false,
    "testFiles": "**/!(*.undefined).feature",
    "video": false
  }
